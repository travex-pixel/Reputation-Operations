# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Impeccable: keep screenshots/report evidence, ignore runtime state
.impeccable/*.png
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/live/
.impeccable/questions/
.impeccable/config.local.json
.impeccable/review/crop-*.png
.impeccable/review/d-*.png
.impeccable/review/m-*.png
.impeccable/review/*-tablet.png
.impeccable/review/notfound-*.png
